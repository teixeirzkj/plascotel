# Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA_PUBLICA

# Dados da loja
VITE_STORE_NAME=Plascotel
VITE_WHATSAPP_NUMBER=5511999999999
VITE_INSTAGRAM_URL=https://instagram.com/plascotel
VITE_STORE_EMAIL=contato@plascotel.com.br
VITE_STORE_ADDRESS=Rua Exemplo, 123 - Centro, Sua Cidade - UF
VITE_STORE_HOURS=Seg a Sex, 9h às 18h | Sáb, 9h às 13h

# Frete (Melhor Envio) — NÃO usar prefixo VITE_ aqui: essas variáveis só são
# lidas por funções serverless e nunca chegam ao navegador. A API deles usa
# OAuth2 (não uma chave fixa): cadastre um aplicativo em melhorenvio.com.br
# (Integrações > Área Dev > Cadastrar aplicativo), com a URL de
# redirecionamento "https://SEU-SITE/api/melhor-envio-callback" e o escopo
# "shipping-calculate". CLIENT_ID/CLIENT_SECRET vêm de lá.
# Depois de configurar essas variáveis na Vercel, acesse uma vez a URL de
# autorização (ver PLASCOTEL/api/_lib/melhorEnvioAuth.ts) pra gerar o
# primeiro token — dali em diante ele se renova sozinho.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_CEP_ORIGEM=

# Pagamento Pix (Mercado Pago) + confirmação por webhook — NÃO usar prefixo
# VITE_ em nenhuma dessas: são lidas só pelas funções serverless em
# api/criar-pagamento.ts e api/mercadopago-webhook.ts, nunca chegam ao
# navegador (é isso que impede o cliente de forjar preço/pagamento).
#
# SUPABASE_SERVICE_ROLE_KEY — Project Settings > API > Project API keys >
#   service_role (diferente da anon key — ignora RLS, por isso nunca pode
#   virar variável VITE_).
# MERCADOPAGO_ACCESS_TOKEN — Suas integrações > seu aplicativo > Credenciais
#   de produção, em mercadopago.com.br/developers. Comece com a de teste
#   pra validar o fluxo antes de trocar pela de produção.
# SITE_URL — URL pública do site (ex: https://plascotel.com.br), usada para
#   montar a notification_url mandada ao Mercado Pago. Se vazio, usa o host
#   da própria requisição.
# MERCADOPAGO_WEBHOOK_SECRET — OBRIGATÓRIA para o pagamento online funcionar:
#   o webhook só aceita chamadas com ?t=SEGREDO na URL e recusa tudo (mesmo
#   um pagamento real confirmado pelo Mercado Pago) se não estiver definida.
#   Gere um valor aleatório longo (ex: openssl rand -hex 32).
# N8N_PEDIDO_PAGO_URL — opcional; URL do workflow n8n que envia a notificação
#   (WhatsApp etc.) quando um pedido é confirmado.
SUPABASE_SERVICE_ROLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
SITE_URL=
MERCADOPAGO_WEBHOOK_SECRET=
N8N_PEDIDO_PAGO_URL=

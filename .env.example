# Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA_PUBLICA

# Dados da loja
VITE_STORE_NAME=Plascotel
VITE_WHATSAPP_NUMBER=5511999999999
VITE_INSTAGRAM_URL=https://instagram.com/plascotel
VITE_STORE_EMAIL=contato@plascotel.com.br
VITE_STORE_ADDRESS=Rua Exemplo, 123 - Centro, Sua Cidade - UF
VITE_STORE_HOURS=Seg a Sex, 9h às 18h | Sáb, 9h às 13h

# Frete (Melhor Envio) — NÃO usar prefixo VITE_ aqui: essas variáveis só são
# lidas pela função serverless em api/frete.ts e nunca chegam ao navegador.
# Gere o token em melhorenvio.com.br (Gerenciar contas > Aplicativos > tokens
# de acesso, com o escopo "Calcular fretes na Plataforma do Melhor Envio").
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CEP_ORIGEM=
MELHOR_ENVIO_SANDBOX=false

# Pagamento InfinitePay + confirmação por webhook — NÃO usar prefixo VITE_ em
# nenhuma dessas: são lidas só pelas funções serverless em
# api/criar-pagamento.ts e api/infinitepay-webhook.ts, nunca chegam ao
# navegador (é isso que impede o cliente de forjar preço/pagamento).
#
# SUPABASE_SERVICE_ROLE_KEY — Project Settings > API > Project API keys >
#   service_role (diferente da anon key — ignora RLS, por isso nunca pode
#   virar variável VITE_).
# INFINITEPAY_HANDLE — a InfiniteTag da conta (sem o "$" na frente), a mesma
#   usada para receber os pagamentos.
# SITE_URL — URL pública do site (ex: https://plascotel.com.br), usada para
#   montar o link de retorno e o webhook_url mandados à InfinitePay. Se
#   vazio, usa o host da própria requisição.
# INFINITEPAY_WEBHOOK_SECRET — OBRIGATÓRIA para o pagamento online funcionar:
#   o webhook só aceita chamadas com ?t=SEGREDO na URL e recusa tudo (mesmo
#   um pagamento real confirmado pela InfinitePay) se não estiver definida.
#   Gere um valor aleatório longo (ex: openssl rand -hex 32).
# N8N_PEDIDO_PAGO_URL — opcional; URL do workflow n8n que envia a notificação
#   (WhatsApp etc.) quando um pedido é confirmado.
SUPABASE_SERVICE_ROLE_KEY=
INFINITEPAY_HANDLE=riquelme-pereira-wkg
SITE_URL=
INFINITEPAY_WEBHOOK_SECRET=
N8N_PEDIDO_PAGO_URL=
